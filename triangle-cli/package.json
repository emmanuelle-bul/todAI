{
  "name": "triangle-cli",
  "version": "1.0.0",
  "description": "A simple CLI for solving common triangle problems.",
  "type": "module",
  "bin": {
    "triangle-solver": "./dist/src/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "tsx src/cli.ts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test test/**/*.test.ts"
  },
  "keywords": [
    "triangle",
    "math",
    "cli",
    "typescript"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  }
}