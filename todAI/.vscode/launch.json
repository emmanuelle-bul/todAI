{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Launch",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}/backend/todAI.Api/todAI.Api.csproj",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Frontend Launch",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "Local:\\s+(https?://\\S+)"
      }
    }
  ],
  "compounds": [
    {
      "name": "Full Stack",
      "configurations": ["Backend Launch", "Frontend Launch"]
    }
  ]
}
